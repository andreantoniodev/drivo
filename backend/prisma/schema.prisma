generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]

  @@map("users")
}

model Vehicle {
  id     String @id @default(uuid())
  userId String

  brand String
  model String
  plate String

  renavam         String?
  chassi          String?
  yearFabrication Int
  yearModel       Int
  color           String?
  fuelType        String?
  category        String?
  mileage         Int?
  nickname        String?

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  crlv  CrlvDocument?
  image VehicleImage?

  @@unique([userId, plate])
  @@map("vehicles")
}

model CrlvDocument {
  id        String @id @default(uuid())
  vehicleId String @unique

  fileName String?
  fileType String?
  fileSize Int?
  fileUrl  String?

  numeroCrLV          String?
  codigoSeguranca     String?
  exercicio           Int?
  dataEmissao         DateTime?
  nomeProprietario    String?
  cpfCnpjProprietario String?
  localRegistro       String?

  rawAiExtraction Json?

  scannedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("crlv_documents")
}

model VehicleImage {
  vehicleId String @id
  mimeType  String
  size      Int
  data      Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}
