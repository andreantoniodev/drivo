# Padrão: valores SEM aspas (use aspas só se o valor tiver espaço ou #). Sem espaços ao redor do "=".
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivo_db?schema=public

# Obrigatório. Gere um valor próprio, por exemplo: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Leitura de CRLV com Google Gemini (chave gratuita em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos de reserva (separados por vírgula), usados quando o principal está sobrecarregado (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Modo demonstração: devolve um CRLV de exemplo sem chamar o Gemini. Deixe "false" em uso real.
GEMINI_MOCK=false
# Cria o usuário e os veículos de demonstração (npm run prisma:seed). Use "false" em produção.
SEED_DEMO=true
