# Padrão: valores SEM aspas (use aspas só se o valor tiver espaço ou #). Sem espaços ao redor do "=".
# Variáveis lidas pelo docker-compose. Copie para ".env" e ajuste:  cp .env.example .env

# Segredo de assinatura do JWT. Gere um valor próprio: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# URL da API vista pelo navegador. É gravada no build do frontend: após mudar, rode
# "docker compose up -d --build web".
NEXT_PUBLIC_API_URL=http://localhost:3001

# Leitura de CRLV com Google Gemini. Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos de reserva (separados por vírgula), usados quando o principal está sobrecarregado (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Modo demonstração: devolve um CRLV de exemplo sem chamar o Gemini (sinalizado na tela).
# Útil para testar sem chave. Mantenha "false" em uso real.
GEMINI_MOCK=false

# Cria o usuário e os veículos de demonstração na subida da API. Use "false" em produção.
SEED_DEMO=true
